# Copy this file to .env on your laptop and fill it in. NEVER commit the real .env file.
# On Render, type these values in the Environment settings instead of using a file.
# Recommended (much higher free-tier rate limits): get a free key at https://console.groq.com
GROQ_API_KEY=
# Optional fallback / alternative: Google Gemini key from https://aistudio.google.com
GEMINI_API_KEY=
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=production
